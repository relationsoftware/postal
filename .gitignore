# Postal .gitignore

# =============================================================================
# Ruby / Rails
# =============================================================================

# Bundler
/.bundle
vendor/bundle

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
*.log

# Byebug
.byebug_history

# Assets
public/assets

# =============================================================================
# Postal Configuration (sensitive - keep examples only)
# =============================================================================

# Main config (use postal.yml.example)
config/postal.yml
config/Caddyfile

# Keys and certificates
config/signing.key
config/smtp.cert
config/smtp.key
config/*.crt
config/*.key
config/*.pem

# Postal subdirectory configs
config/postal/**/*

# Certs directory (all contents)
config/certs/*
!config/certs/.keep

# Test config
spec/config/postal.local.yml

# =============================================================================
# Environment
# =============================================================================

# Environment files
.env
.env.*
!.env.example

# Docker override
docker-compose.override.yml

# Local Procfile
Procfile.local

# Version files (generated)
VERSION
BRANCH

# =============================================================================
# Backup and generated files
# =============================================================================

# Backup files
*.bak
*.backup
*.sql
config-backup*.tar.gz
backup*.sql

# OpenAPI generation logs
openapi_gen*.log

# =============================================================================
# IDE and OS
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# =============================================================================
# Other
# =============================================================================

# RuboCop cache
.rubocop-https*

# Coverage
coverage/

# Node (if any)
node_modules/
