version: 2

postal:
  web_hostname: postal.yourdomain.com
  web_protocol: https
  smtp_hostname: postal.yourdomain.com

main_db:
  host: mariadb
  username: root
  password: postal
  database: postal

message_db:
  host: mariadb
  username: root
  password: postal
  prefix: postal

smtp_server:
  default_bind_address: "::"

dns:
  # Specify the DNS records that you have configured.
  mx_records:
    - mx.postal.yourdomain.com
  spf_include: spf.postal.yourdomain.com
  return_path_domain: rp.postal.yourdomain.com
  route_domain: routes.postal.yourdomain.com
  track_domain: track.postal.yourdomain.com

smtp:
  # Specify an SMTP server that can be used to send messages from the Postal management
  # system to users.
  host: 127.0.0.1
  port: 2525
  username: # Complete when Postal is running
  password: # Complete when Postal is running
  from_name: Postal
  from_address: postal@yourdomain.com

rails:
  # This is generated automatically. It should be a random string unique to your installation.
  secret_key: REPLACE_WITH_SECRET_KEY
