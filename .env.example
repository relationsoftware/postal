# Postal Configuration
# Copy this file to .env and adjust the values

# Postal version to use
POSTAL_VERSION=3.3.4

# Number of worker replicas
WORKER_REPLICAS=1

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=your_secure_password_here

# Your domain configuration
# Update these in config/postal.yml as well
POSTAL_WEB_HOSTNAME=postal.yourdomain.com
POSTAL_SMTP_HOSTNAME=postal.yourdomain.com

# DNS Records (configure these as well)
# MX Records
POSTAL_MX_RECORDS=mx.postal.yourdomain.com
# SPF Include
POSTAL_SPF_INCLUDE=spf.postal.yourdomain.com
# Return Path Domain
POSTAL_RETURN_PATH_DOMAIN=rp.postal.yourdomain.com
# Route Domain
POSTAL_ROUTE_DOMAIN=routes.postal.yourdomain.com
# Track Domain
POSTAL_TRACK_DOMAIN=track.postal.yourdomain.com
